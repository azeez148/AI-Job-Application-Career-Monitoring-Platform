{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:career-platform:claim:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "tenant_id",
    "user_id",
    "kind",
    "value",
    "source",
    "verification"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "employer",
        "title",
        "dates",
        "skill",
        "metric",
        "education",
        "certification"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "sha256",
        "locator",
        "quote"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
